# Copy to .env and fill in.

# Postgres connection string: a Neon branch (free) or a local Postgres.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Signs the log-in session cookie. Use a long random string (32+ characters) outside local dev.
SESSION_SECRET="dev-only-secret-change-me-0123456789abcdef"

# Base URL used in links inside emails.
APP_URL="http://localhost:3000"

# Email. With no RESEND_API_KEY, emails are not sent: they are logged and shown at /dev/outbox.
RESEND_API_KEY=""
EMAIL_FROM="Leadership App <noreply@example.com>"

# Protects /api/cron/send-emails, which sends scheduled emails (reminders).
CRON_SECRET="dev-cron-secret"

# Demo mode (online demo with fake data only): emails are shown at /dev/outbox instead
# of sent, and the whole app sits behind this shared password. Both must be set.
DEMO_MODE=""
DEMO_PASSWORD=""
